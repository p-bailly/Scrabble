rules_version = '2';

// Règles de sécurité des parties à deux. À coller dans la console Firebase :
// Firestore Database → Règles → Publier.
service cloud.firestore {
  match /databases/{base}/documents {

    function connecte() {
      return request.auth != null;
    }

    // Fiche de chaque joueur : lisible par tous les joueurs connectés, modifiable par lui seul.
    match /joueurs/{uid} {
      // Appareils qui reçoivent les notifications appli fermée (jeton FCM) : lui seul les lit et les écrit ; la Cloud
      // Function (functions/) les lit avec ses droits d'administration.
      match /appareils/{appareil} {
        allow read, write: if connecte() && request.auth.uid == uid;
      }

      // Données solo synchronisées (parties en cours, historiques, résultats contre l'IA, réglages) : lui seul les lit et
      // les écrit. Un élément est une version datée (`majLe`) ; la plus récente gagne, donc une écriture plus ancienne que
      // celle du serveur est refusée (un appareil resté hors ligne ne peut pas écraser le travail des autres).
      match /solo/{element} {
        allow read, delete: if connecte() && request.auth.uid == uid;
        allow create, update: if connecte() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['type', 'id', 'donnees', 'majLe', 'supprime'])
          && request.resource.data.type is string
          && request.resource.data.id is string
          && request.resource.data.donnees is string && request.resource.data.donnees.size() < 900000
          && request.resource.data.majLe is int
          && request.resource.data.supprime is bool
          && (resource == null || request.resource.data.majLe >= resource.data.majLe);
      }

      allow get: if connecte();
      // Chercher un joueur à inviter (par sa clé de recherche) : 10 fiches au plus par requête, et une requête sans
      // `limit` est refusée, pour qu'on ne puisse pas tout lister d'un coup.
      allow list: if connecte() && request.query.limit <= 10;
      allow write: if connecte() && request.auth.uid == uid
        && request.resource.data.pseudo is string
        && request.resource.data.pseudo.size() > 0 && request.resource.data.pseudo.size() <= 20
        // La clé de recherche (le pseudo simplifié) n'est écrite que si le joueur accepte d'être trouvé.
        && (!('recherche' in request.resource.data)
          || (request.resource.data.recherche is string && request.resource.data.recherche.size() <= 20))
        && (!('visible' in request.resource.data) || request.resource.data.visible is bool);
    }

    match /parties/{code} {
      function partie() {
        return get(/databases/$(base)/documents/parties/$(code)).data;
      }
      function partieApres() {
        return getAfter(/databases/$(base)/documents/parties/$(code)).data;
      }
      function joueur(d) {
        return request.auth.uid in d.joueurs;
      }
      function inchange(champs) {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(champs);
      }
      function seulementChange(champs) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(champs);
      }
      // Joueur invité directement à cette partie (champ absent des parties d'avant les invitations).
      function invite(d) {
        return request.auth.uid in d.get('invites', []);
      }

      // Lecture : les deux joueurs ; le joueur invité ; une partie en attente d'adversaire est lisible par qui a le code.
      allow read: if connecte() && (joueur(resource.data) || invite(resource.data) || resource.data.etat == 'attente');

      // Création : par son créateur, seul joueur inscrit, en attente d'un adversaire (et d'un invité au plus).
      allow create: if connecte()
        && request.resource.data.createur == request.auth.uid
        && request.resource.data.joueurs == [request.auth.uid]
        && request.resource.data.etat == 'attente'
        && request.resource.data.nbCoups == 0
        && request.resource.data.get('invites', []).size() <= 1
        && !invite(request.resource.data);

      allow update: if connecte() && (
        // Rejoindre une partie en attente : on s'ajoute comme second joueur, la partie commence.
        (resource.data.etat == 'attente'
          && request.auth.uid != resource.data.createur
          && request.resource.data.joueurs == [resource.data.createur, request.auth.uid]
          && request.resource.data.etat == 'encours'
          && request.resource.data.nbCoups == 0
          && inchange(['createur', 'code', 'creeLe', 'plateau']))
        ||
        // Jouer : seulement le joueur dont c'est le tour, un coup à la fois.
        (resource.data.etat == 'encours'
          && resource.data.tour == request.auth.uid
          && request.resource.data.nbCoups == resource.data.nbCoups + 1
          && request.resource.data.tour != request.auth.uid
          && inchange(['createur', 'code', 'creeLe', 'joueurs']))
        ||
        // Abandonner une partie en cours (l'adversaire gagne).
        (resource.data.etat == 'encours' && joueur(resource.data)
          && request.resource.data.etat == 'finie'
          && request.resource.data.nbCoups == resource.data.nbCoups
          && inchange(['createur', 'code', 'creeLe', 'joueurs', 'plateau', 'sac', 'scores']))
        ||
        // Inviter un joueur, ou annuler l'invitation : le créateur, tant que personne n'a rejoint (un invité au plus).
        (resource.data.etat == 'attente'
          && resource.data.createur == request.auth.uid
          && seulementChange(['invites', 'refus', 'pseudos', 'majLe'])
          && request.resource.data.invites.size() <= 1
          && !invite(request.resource.data))
        ||
        // Refuser une invitation : on se retire des invités et le créateur le voit dans « refus ».
        (resource.data.etat == 'attente'
          && invite(resource.data)
          && seulementChange(['invites', 'refus', 'majLe'])
          && request.resource.data.invites == resource.data.invites.removeAll([request.auth.uid])
          && request.resource.data.refus == resource.data.get('refus', []).concat([request.auth.uid]))
      );

      // Supprimer : le créateur, tant que personne n'a rejoint.
      allow delete: if connecte() && resource.data.etat == 'attente' && resource.data.createur == request.auth.uid;

      // Chevalet de chaque joueur : lui seul le lit et l'écrit.
      match /chevalets/{uid} {
        allow read: if connecte() && request.auth.uid == uid;
        allow write: if connecte() && request.auth.uid == uid && joueur(partieApres());
      }

      // Historique des coups : lisible par les deux joueurs ; chaque coup est écrit par celui dont c'était le
      // tour, en même temps que la partie (même lot d'écritures), avec le bon numéro.
      match /coups/{n} {
        allow read: if connecte() && joueur(partie());
        allow create: if connecte()
          && request.resource.data.uid == request.auth.uid
          && partie().tour == request.auth.uid
          && partieApres().nbCoups == int(n)
          && request.resource.data.n == int(n);
        allow update, delete: if false;
      }
    }
  }
}
